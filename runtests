#!/usr/bin/env python
"""Run the test suite or selected Django test labels."""

import os
import re
import sys
from importlib import import_module
from unittest import TestCase

import django
from django.conf import settings
from django.test.utils import get_runner

if __name__ == "__main__":
    # Django calls the named object, so only accept test modules, classes, or methods.
    for label in sys.argv[1:]:
        if label != "tests" and not re.fullmatch(
            r"tests\.test_\w+(?:\.[A-Z]\w*(?:\.test_\w+)?)?", label
        ):
            print(f"Unsupported test argument: {label}", file=sys.stderr)
            sys.exit(2)
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "tests.settings")
    django.setup()
    # unittest calls named objects, including classes that are not tests.
    for label in sys.argv[1:]:
        parts = label.split(".")
        if len(parts) < 3:
            continue
        module = import_module(".".join(parts[:2]))
        candidate = getattr(module, parts[2], None)
        if not isinstance(candidate, type) or not issubclass(candidate, TestCase):
            print(f"Unsupported test argument: {label}", file=sys.stderr)
            sys.exit(2)
    TestRunner = get_runner(settings)
    test_runner = TestRunner()
    # Get test modules from command line args or default to all
    test_labels = sys.argv[1:] or ["tests"]
    failures = test_runner.run_tests(test_labels)
    if failures:
        sys.exit(1)
